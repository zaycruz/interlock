{
  "name": "@raava/interlock",
  "version": "0.0.1",
  "description": "Local coordination for agent sessions: exact-path leases, task claims, pane messaging, and inbox digests.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "main": "./dist/src/core/index.js",
  "types": "./dist/src/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./coordination": {
      "types": "./dist/src/coordination/index.d.ts",
      "import": "./dist/src/coordination/index.js"
    }
  },
  "bin": {
    "interlock": "./dist/src/cli/main.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/core/*.test.js dist/test/contracts/*.test.js dist/test/cli/*.test.js dist/test/beads/*.test.js dist/test/coordination/*.test.js",
    "test:core": "npm run build && node --test dist/test/core/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "unicode-case-folding": "1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  }
}
