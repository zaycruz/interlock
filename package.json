{
  "name": "interlock-lease-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "main": "./dist/src/core/index.js",
  "types": "./dist/src/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    }
  },
  "files": [
    "dist/src/core"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/core/*.test.js",
    "test:core": "npm run build && node --test dist/test/core/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  }
}
